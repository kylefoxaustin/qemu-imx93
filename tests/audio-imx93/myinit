#!/bin/sh
# Audio playback check: load the (modular) ASoC drivers so the cards register,
# then play a square wave on the wm8962/SAI3 card to drive the eDMA3 cyclic ->
# SAI3 TX FIFO datapath. A clean "PASS" with "drain -> Success" means the DMA
# paced the whole stream at the audio rate without under-running.
PATH=/sbin:/usr/sbin:/bin:/usr/bin; export PATH
/bin/mount -t proc proc /proc 2>/dev/null
/bin/mount -t sysfs sysfs /sys 2>/dev/null
/bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null

echo "=== AUDIO: loading SAI/codec drivers ==="
for m in snd-soc-fsl-utils snd-soc-fsl-sai snd-soc-fsl-micfil imx-pcm-dma \
         snd-soc-wm8962 snd-soc-dmic snd-soc-imx-card snd-soc-fsl-asoc-card \
         snd-soc-simple-card snd-soc-simple-card-utils; do
    /sbin/modprobe "$m" 2>&1 | sed "s/^/modprobe $m: /"
done
sleep 3

echo "=== /proc/asound/cards ==="
cat /proc/asound/cards 2>/dev/null
echo "=== /proc/asound/pcm ==="
cat /proc/asound/pcm 2>/dev/null

if [ -x /pcm_play ]; then
    # Find the wm8962 card by NAME. Card indices are assigned by the kernel in
    # registration order, so they move: MICFIL registering shifted wm8962 from
    # card 1 to card 2, and a test hardcoding hw:1,0 then played into a
    # capture-only device and failed to open - silently, for as long as nobody
    # read the console. An index is not an identity.
    CARD=$(awk -F'[][ ]+' '/wm8962audio/ {print $2}' /proc/asound/cards | head -1)
    # The rate is chosen by the harness, not baked in: a SAI that assumes one
    # rate is invisible to a test that only ever asks for that rate.
    RATE=$(cat /rate 2>/dev/null || echo 48000)
    if [ -z "$CARD" ]; then
        echo "PLAY: FAIL (no wm8962audio card in /proc/asound/cards)"
    else
        echo "=== PLAYBACK on wm8962/SAI3 (hw:${CARD},0) at ${RATE} Hz ==="
        /pcm_play "hw:${CARD},0" 1 "$RATE"
    fi
fi

# PDM capture on the MICFIL card, at the SAME rate the harness chose. This is
# what proves the MICFIL paces from the CCM's pdm_root: the fsl-micfil clk
# driver programs pdm_root to RATE*1024, so the model's capture-start trace must
# report a sample rate that TRACKS ${RATE} (16000 vs 48000), not a constant.
if [ -x /pcm_capture ]; then
    MIC=$(awk -F'[][ ]+' '/micfilaudio/ {print $2}' /proc/asound/cards | head -1)
    RATE=$(cat /rate 2>/dev/null || echo 48000)
    if [ -z "$MIC" ]; then
        echo "CAPTURE: FAIL (no micfilaudio card in /proc/asound/cards)"
    else
        echo "=== CAPTURE on micfil (hw:${MIC},0) at ${RATE} Hz ==="
        /pcm_capture "hw:${MIC},0" 1 "$RATE"
    fi
fi
echo "=== AUDIO TEST DONE ==="
# Power off rather than spin: QEMU writes the wav header on close, so a killed
# QEMU leaves a truncated capture and the samples - which ARE the assertion -
# cannot be read back.
sync
/sbin/poweroff -f 2>/dev/null || poweroff -f 2>/dev/null
while true; do sleep 5; done
